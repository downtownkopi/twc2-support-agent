# LLM — via OpenRouter (see design doc amendment A1: swapped from Anthropic for cost)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-plus
# Used as the HTTP-Referer header on OpenRouter requests (their attribution convention).
PUBLIC_URL=https://support.camans.twc2.org.sg

# Main server (internal, localhost-only per design doc)
MAIN_SERVER_INTERNAL_URL=http://127.0.0.1:4000
# Shared secret for HMAC-signing calls into the main server's intake API.
# Must match the main server's CHAT_INTAKE_HMAC_SECRET env var exactly.
INTAKE_HMAC_SECRET=

# Service
PORT=5099
NODE_ENV=production

# Rate limiting / identity verification
IDENTITY_MATCH_MAX_ATTEMPTS=4
IDENTITY_LOCKOUT_MINUTES=30
CHAT_MAX_TURNS=25
CHAT_MESSAGES_PER_MINUTE=15

# Cloudflare Turnstile (captcha) — required starting identity-match attempt #2.
# Leave TURNSTILE_SECRET_KEY empty to disable captcha enforcement during local dev.
TURNSTILE_SECRET_KEY=
